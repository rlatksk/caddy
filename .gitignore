.gradle/
build/
*/build/
*.part

# Feasibility docs — not part of the repo
*.pdf

# Local-only source list. Never published: the engine ships no sources and the
# maintainer does not provide or endorse any repository. Regenerate with
# tools/gen_repo.py; it stays on your machine.
/repo/*
!/repo/index.example.json

# Your system -> collection map. Same reason: not published.
tools/sources.local.json

# Built APKs are distributed as GitHub releases, not committed
/releases/

# Machine-specific SDK path
local.properties

# Scratch space for local probe pages and downloads
/.tmp/

# Release signing material. Never committed: the keystore is what proves an
# update came from this project.
/keystore.properties
*.jks
*.keystore

# Impeccable skill scratch state (decision payloads, build gates)
/.impeccable/
