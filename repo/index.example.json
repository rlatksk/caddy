{
  "schemaVersion": 1,
  "name": "Example Retro Repo",
  "sources": [
    {
      "id": "example_archive",
      "name": "Example Archive",
      "version": "1.0.0",
      "transport": "http",
      "adapter": "archive_org",
      "systems": ["genesis", "psx"],
      "config": {
        "collections": {
          "genesis": "sega_genesis_library",
          "psx": "psxgames"
        }
      }
    },
    {
      "id": "example_minerva",
      "name": "Example Torrent Archive",
      "version": "1.0.0",
      "transport": "torrent",
      "adapter": "minerva",
      "systems": ["gba", "psx"],
      "config": {
        "baseUrl": "https://minerva-archive.org",
        "paths": {
          "gba": "No-Intro/Nintendo - Game Boy Advance",
          "psx": "Redump/Sony - PlayStation"
        }
      }
    },
    {
      "id": "example_html",
      "name": "Example Scraped Site",
      "version": "1.0.0",
      "transport": "http",
      "adapter": "html_index",
      "systems": ["gba"],
      "config": {
        "baseUrl": "https://www.romsgames.net",
        "listings": {
          "gba": {
            "url": "https://www.romsgames.net/roms/gameboy-advance/",
            "itemSelector": "a[href*='-rom-']",
            "titleSelector": "img",
            "downloadSelector": "img"
          }
        }
      }
    }
  ]
}
